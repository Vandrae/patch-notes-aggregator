# What is NOT sent to Docker when building the image (the "build context").
# Anything listed here can never end up inside an image, which matters most for secrets.

# secrets and local state
.env
.env.*
data/

# build output and tool caches, rebuilt inside the image
target/
web/node/
web/node_modules/
web/dist/

# repository and editor files
.git/
.github/
.claude/
.idea/
.vscode/

# not needed to build or run the app
docs/
README.md
*.png
Dockerfile
.dockerignore
compose*.yaml
