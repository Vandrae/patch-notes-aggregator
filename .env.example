# Copy to `.env` (which is git-ignored) and fill in. Two things read this file:
#   - the app, when you run it directly (spring.config.import picks up ./.env)
#   - docker compose, which loads .env automatically for ${...} substitution in compose.prod.yaml

# Steam Web API key (https://steamcommunity.com/dev/apikey). The news feed is keyless; the key is used to import the
# full game catalog, fetch covers / genres / ratings, and read your Steam name and avatar at login.
STEAM_API_KEY=

# Signs the session cookie (HS256): at least 32 random characters. If empty, the app generates a random key on every
# start and everyone is signed out on restart. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Where browsers reach this app. Steam sends people back here after login. In production this MUST be your real https
# address (the app refuses to start otherwise; http://localhost is the one exception, for trying it on your machine).
# https also turns on the Secure flag for the session cookie. Running the jar directly, the default below is right.
# With compose.prod.yaml (Caddy serves https) set it to https://<DOMAIN>, or https://localhost to try it on your machine.
PUBLIC_BASE_URL=http://localhost:8080

# Only for compose.prod.yaml. Your site's address, with no https:// in front (for example patchnotes.example.com).
# Caddy gets a free certificate for it automatically, so its DNS A record must already point at this machine and ports
# 80 and 443 must be open. Leave unset to try the stack on your own machine at https://localhost.
# DOMAIN=

# Only for compose.prod.yaml (the MySQL container). Choose your own long random values.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
